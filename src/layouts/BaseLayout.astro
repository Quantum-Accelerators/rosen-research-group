---
import '../styles/global.css';
import '../styles/accessibility.css';
import { getEntry } from 'astro:content';
const site = (await getEntry('pages', 'site'))!.data as any;
const { title = site.brand, description = site.description } = Astro.props;
const nav = site.navigation;
const [brandLead, ...brandRest] = site.brand.split(' ');
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151515" />
    <link rel="icon" href="/images/quacc-duck.png" />
    <title>{title === site.brand ? title : `${title} — ${site.brand}`}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="utility"><a href={site.universityUrl}>{site.universityLabel}</a><span>{site.department}</span></div>
      <div class="nav-shell">
        <a class="brand" href="/"><img src="/images/quacc-duck.png" alt="" /><span>{brandLead} <b>{brandRest.join(' ')}</b></span></a>
        <button class="menu-button" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation">Menu</button>
        <nav id="main-navigation" aria-label="Main navigation">
          {nav.map((item:any) => {
            const active = path === item.url || path.startsWith(item.url + '/');
            return <a class:list={{ active }} aria-current={active ? 'page' : undefined} href={item.url}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer>
      <div><a class="footer-brand" href="/">{site.brand}</a><p>{site.footerText}</p><address>{site.address}</address></div>
      <div><h2>Explore</h2><a href="/research">Research</a><a href="/members">People</a><a href="/publications">Publications</a><a href="/news">News</a></div>
      <div><h2>Connect</h2><a href={site.githubUrl}>GitHub ↗</a><a href="/positions">Join the group</a></div>
      <div class="footer-legal"><p>© {new Date().getFullYear()} The Trustees of Princeton University</p><nav aria-label="Princeton policies"><a href={site.diversityUrl}>Diversity &amp; Non-Discrimination</a><a href={site.accessibilityUrl}>Accessibility Help</a></nav></div>
    </footer>
    <style>footer{grid-template-columns:2fr 1fr 1fr}footer address{font-style:normal;color:#888;font-size:.85rem;margin-top:.8rem}.footer-legal{grid-column:1/-1;border-top:1px solid #333;padding-top:1.25rem;display:flex;justify-content:space-between;gap:1rem;color:#777;font-size:.7rem}.footer-legal p{margin:0}.footer-legal nav{display:flex;gap:1.25rem}.footer-legal a{color:#888;margin:0}.footer-legal a:hover{color:#ccc}@media(max-width:800px){footer{grid-template-columns:1fr 1fr}.footer-legal{flex-direction:column}.footer-legal nav{flex-wrap:wrap}}@media(max-width:600px){footer{grid-template-columns:1fr}}</style>
    <style is:global>.prose .button{color:var(--ink)}</style>
    <script is:inline>
      const button=document.querySelector('.menu-button'); const nav=document.querySelector('.nav-shell nav');
      const setMenuOpen=(open)=>{button?.setAttribute('aria-expanded',String(open));button?.setAttribute('aria-label',open?'Close navigation':'Open navigation');nav?.classList.toggle('open',open)};
      button?.addEventListener('click',()=>setMenuOpen(button.getAttribute('aria-expanded')!=='true'));
      nav?.addEventListener('click',(event)=>{if(event.target.closest('a'))setMenuOpen(false)});
      document.addEventListener('keydown',(event)=>{if(event.key==='Escape'&&button?.getAttribute('aria-expanded')==='true'){setMenuOpen(false);button.focus()}});
    </script>
  </body>
</html>

