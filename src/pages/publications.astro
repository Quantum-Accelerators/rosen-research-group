---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import publications from '../data/publications.json';

const submitted = publications.filter((publication) => publication.status === 'submitted');
const published = publications.filter((publication) => publication.status === 'published');
const formatCitation = (citation: string) => {
  let formatted = citation.replaceAll('=', '†').replaceAll('†', '<sup>†</sup>');
  formatted = formatted.replace(/_([^_]+)_/g, '<em>$1</em>');
  formatted = formatted.replace(/ — (.+)$/, '<span class="publication-note">$1</span>');
  return formatted;
};
---
<BaseLayout title="Publications">
  <PageHero title="Publications" />
  <section class="section white">
    <div class="container">
      <div class="publication-tools">
        <a class="button" href="https://scholar.google.com/citations?hl=en&user=lHBjgLsAAAAJ&view_op=list_works&sortby=pubdate">Google Scholar ↗</a>
      </div>

      <section class="publication-section" aria-labelledby="submitted-heading">
        <h2 id="submitted-heading">Submitted Articles and Pre-Prints</h2>
        <p class="legend"><b>Notation:</b> * corresponding author · † equal contribution</p>
        <div class="publication-list">
          {submitted.map((publication) => <article class="publication"><p class="number">{String(publication.number).padStart(2, '0')}</p><h3>{publication.url ? <a href={publication.url}>{publication.title} ↗</a> : publication.title}</h3><p set:html={formatCitation(publication.citation)} /></article>)}
        </div>
      </section>

      <section class="publication-section" aria-labelledby="published-heading">
        <h2 id="published-heading">Published and In Press</h2>
        <div class="publication-list">
          {published.map((publication) => <article class="publication"><p class="number">{String(publication.number).padStart(2, '0')}</p><h3>{publication.url ? <a href={publication.url}>{publication.title} ↗</a> : publication.title}</h3><p set:html={formatCitation(publication.citation)} /></article>)}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .publication-tools{display:flex;align-items:center;justify-content:center}
  .legend{margin:-.75rem 0 1.5rem;color:var(--muted);font-size:.85rem}
  .publication-section{padding-top:clamp(3.5rem,7vw,6rem)}
  .publication-tools + .publication-section{padding-top:clamp(1.75rem,3vw,2.5rem)}
  .publication-section h2{font-size:clamp(2.2rem,4vw,4rem);margin-bottom:2rem}
  .publication-list{border-top:1px solid var(--line)}
  .publication h3 a{text-decoration-thickness:1px;text-underline-offset:4px}
  .publication h3 a:hover{color:var(--orange)}
  .publication :global(sup){font-size:.67em;line-height:0;vertical-align:super;margin-left:.04em}
  .publication :global(em){font-style:italic;color:var(--ink)}
  .publication :global(.publication-note){display:block;margin-top:.45rem;color:var(--ink);font-size:.92em;font-weight:500}
</style>

