---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getCollection, getEntry, render } from 'astro:content';
const page = (await getEntry('pages', 'positions'))!.data as any;
const opportunities = await Promise.all((await getCollection('opportunities')).sort((a,b)=>a.data.order-b.data.order).map(async entry => ({ entry, Content: (await render(entry)).Content })));
---
<BaseLayout title="Positions"><PageHero title={page.title} intro={page.intro}/><section class="section white"><div class="container">{opportunities.map(({entry,Content})=><article class="opportunity grid-2"><div><p class="eyebrow">{entry.data.label}</p><h2>{entry.data.title}</h2></div><div class="prose"><Content/></div></article>)}</div></section></BaseLayout><style>.opportunity{padding:4rem 0;border-bottom:1px solid var(--line)}.opportunity:first-child{padding-top:0}</style>
