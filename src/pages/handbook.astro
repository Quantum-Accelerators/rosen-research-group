---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const values=[['Kindness','We emphasize kindness towards ourselves, one another, and our community in all that we do.'],['Belonging','We work together to create a welcoming environment in which every group member feels they belong.'],['Respect','We do not tolerate harassment or discrimination in any form. Antagonistic behavior of any kind is not tolerated.'],['Honest communication','It is okay to be wrong and make mistakes. We value direct feedback, acknowledging errors, and growing from them.'],['Asking for help','Everyone is encouraged to proactively ask for help and offer it. Help can come from anyone.'],['Honoring contributions','Every member of our research community deserves respect, regardless of formal lab position.'],['Scientific integrity','We perform rigorous, reproducible, and transparent research—even when results are inconvenient.'],['Respect for time','Everyone’s time is valuable, and we try to be thoughtful about it in our day-to-day interactions.'],['Coding best practices','Scientific software is as important as the science itself. We continually refine our practices and abilities.'],['Open science','We believe open and accessible work accelerates problem solving and scientific advancement.']];
---
<BaseLayout title="Handbook"><PageHero title="Handbook"/><section class="section white"><div class="container grid-2"><div><h2>Logistics</h2></div><div class="prose"><p>Logistics for how the Rosen Group is run, together with practical how-to guides, live in our public group handbook.</p><a class="button" href="https://rosengroup.slite.page/p/a5o5edzOXesjc8/Rosen-Group-Handbook">Open the full handbook ↗</a></div></div></section><section class="section"><div class="container"><h2>Shared Values</h2><div class="values">{values.map(([title,text],i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section></BaseLayout><style>.values{display:grid;grid-template-columns:1fr 1fr;margin-top:3rem;border-top:1px solid var(--line)}.values article{padding:2rem;border-bottom:1px solid var(--line)}.values article:nth-child(odd){border-right:1px solid var(--line)}.values span{font-size:.72rem;color:var(--orange)}.values h3{margin:.5rem 0}.values p{color:var(--muted)}@media(max-width:700px){.values{grid-template-columns:1fr}.values article:nth-child(odd){border-right:0}}</style>
