---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'handbook'))!.data as any;
---
<BaseLayout title={page.title}><PageHero title={page.title}/><section class="section white"><div class="container grid-2"><div><h2>{page.logisticsTitle}</h2></div><div class="prose"><p>{page.logisticsText}</p><a class="button" href={page.handbookUrl}>Open the group handbook ↗</a></div></div></section><section class="section"><div class="container"><h2>{page.valuesTitle}</h2><div class="values">{page.values.map((value:any,i:number)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{value.title}</h3><p>{value.text}</p></article>)}</div></div></section></BaseLayout><style>.values{display:grid;grid-template-columns:1fr 1fr;margin-top:3rem;border-top:1px solid var(--line)}.values article{padding:2rem;border-bottom:1px solid var(--line)}.values article:nth-child(odd){border-right:1px solid var(--line)}.values span{font-size:.72rem;color:var(--orange)}.values h3{margin:.5rem 0}.values p{color:var(--muted)}@media(max-width:700px){.values{grid-template-columns:1fr}.values article:nth-child(odd){border-right:0}}</style>
