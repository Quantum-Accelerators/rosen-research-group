---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'software'))!.data as any;
---
<BaseLayout title="Software"><PageHero title={page.title} intro={page.intro}/>
<section class="org-banner"><div class="container"><div><p class="eyebrow">GitHub organization</p><h2>{page.organizationTitle}</h2><p>{page.organizationText}</p></div><a class="button ghost" href={page.organizationUrl}>@Quantum-Accelerators ↗</a></div></section>
<section class="section white"><div class="container grid-2"><div class="image-frame software-img"><img src={page.softwareImage} alt={page.softwareImageAlt}/></div><div class="prose"><p class="eyebrow">Open-source software</p><h2>{page.softwareTitle}</h2><p>{page.softwareText}</p><a class="button" href={page.quaccUrl}>View QuAcc on GitHub ↗</a></div></div></section>
<section class="section"><div class="container grid-2"><div><p class="eyebrow">Open datasets</p><h2>{page.dataTitle}</h2><div class="prose"><p>{page.dataText}</p><ul class="rule-list">{page.datasets.map((dataset:any)=><li><a href={dataset.url}>{dataset.label} ↗</a></li>)}</ul></div></div><div class="image-frame software-img"><img src={page.dataImage} alt={page.dataImageAlt}/></div></div></section></BaseLayout>
<style>.org-banner{background:#eee8de;color:var(--ink);padding:clamp(2rem,4vw,3.25rem) 0;border-top:1px solid #e2d8c8;border-bottom:1px solid #d8cdbd}.org-banner .container{display:flex;align-items:center;justify-content:space-between;gap:2rem}.org-banner .eyebrow{color:var(--orange);margin-bottom:.45rem}.org-banner h2{font:400 clamp(1.8rem,3vw,2.8rem)/1.1 var(--serif);margin:0}.org-banner p{margin:.35rem 0 0}.org-banner .button.ghost{color:var(--ink);border-color:#837768;background:#fff}.org-banner .button.ghost:hover{background:var(--ink);color:#fff;border-color:var(--ink)}.software-img{background:#fff;min-height:360px;display:grid;place-items:center;padding:2rem}.software-img img{object-fit:contain;max-height:320px}@media(max-width:700px){.org-banner .container{align-items:flex-start;flex-direction:column}}</style>
