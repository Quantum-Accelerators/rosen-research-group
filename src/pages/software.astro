---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'software'))!.data as any;
---
<BaseLayout title="Software"><PageHero title={page.title} intro={page.intro}/><section class="section white"><div class="container grid-2"><div class="image-frame software-img"><img src={page.softwareImage} alt={page.softwareImageAlt}/></div><div class="prose"><p class="eyebrow">Open-source software</p><h2>{page.softwareTitle}</h2><p>{page.softwareText} <a href={page.organizationUrl}>Quantum-Accelerators GitHub organization ↗</a></p><a class="button" href={page.quaccUrl}>View quacc on GitHub ↗</a></div></div></section><section class="section"><div class="container grid-2"><div><p class="eyebrow">Open datasets</p><h2>{page.dataTitle}</h2><div class="prose"><p>{page.dataText}</p><ul class="rule-list">{page.datasets.map((dataset:any)=><li><a href={dataset.url}>{dataset.label} ↗</a></li>)}</ul></div></div><div class="image-frame software-img"><img src={page.dataImage} alt={page.dataImageAlt}/></div></div></section></BaseLayout><style>.software-img{background:#fff;min-height:360px;display:grid;place-items:center;padding:2rem}.software-img img{object-fit:contain;max-height:320px}</style>
