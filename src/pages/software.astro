---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Software"><PageHero title="Software & data" intro="Open tools and openly accessible datasets that accelerate computational materials science."/><section class="section white"><div class="container grid-2"><div class="image-frame software-img"><img src="/images/quacc-logo.png" alt="quacc logo"/></div><div class="prose"><p class="eyebrow">Open-source software</p><h2>The Quantum Accelerator.</h2><p>Explore all of our group software through the <a href="https://github.com/Quantum-Accelerators">Quantum-Accelerators GitHub organization</a>, including <b>quacc</b>, our flexible, high-throughput computational materials science library.</p><a class="button" href="https://github.com/Quantum-Accelerators/quacc">View quacc on GitHub ↗</a></div></div></section><section class="section"><div class="container grid-2"><div><p class="eyebrow">Open datasets</p><h2>Data for discovery.</h2><div class="prose"><p>We curate quantum-mechanical data and interfaces that make metal–organic framework research easier to explore, reproduce, and extend.</p><ul class="rule-list"><li><a href="https://doi.org/10.6084/m9.figshare.13147324">QMOF and QMOF-Thermo Database ↗</a></li><li><a href="https://materialsproject.org/mofs">Materials Project MOF Explorer ↗</a></li></ul></div></div><div class="image-frame software-img"><img src="/images/qmof-logos.png" alt="QMOF database logos"/></div></div></section></BaseLayout><style>.software-img{background:#fff;min-height:360px;display:grid;place-items:center;padding:2rem}.software-img img{object-fit:contain;max-height:320px}</style>
