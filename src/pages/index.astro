---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const news = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);
const page = (await getEntry('pages', 'home'))!.data as any;
---
<BaseLayout>
  <section class="hero">
    <div class="hero-image"></div><div class="hero-shade"></div>
    <div class="hero-copy"><p class="eyebrow">{page.heroEyebrow}</p><h1>{page.heroTitle}<br/><em>{page.heroAccent}</em></h1><p>{page.heroIntro}</p><a class="button" href="/research">Explore our research <span>→</span></a></div>
  </section>
  <section class="section white"><div class="container grid-2"><div><p class="eyebrow">{page.researchEyebrow}</p><h2>{page.researchTitle}</h2></div><div class="prose"><p>{page.researchText}</p><a class="text-link" href="/research">Explore the research program →</a></div></div></section>
  <section class="section research-map"><div class="container"><div class="section-head"><div><p class="eyebrow">Research areas</p><h2>{page.areasTitle}</h2></div></div><div class="cards">{page.areas.map((area:any, index:number)=><article class:list={{card:true,crosscut:index===2}}><span class="number">{area.label}</span><h3>{area.title}</h3><p>{area.text}</p></article>)}</div></div></section>
  <section class="section dark"><div class="container"><div class="grid-2"><div><p class="eyebrow">Latest</p><h2>{page.latestTitle}</h2></div><div class="news-dark">{news.slice(0,5).map(item=><a href={`/news/${item.id}`}><time>{item.data.date}</time><span>{item.data.title}</span><b>↗</b></a>)}</div></div><p style="margin-top:2rem"><a class="button ghost" href="/news">View all news</a></p></div></section>
  <section class="section"><div class="container callout grid-2"><div><p class="eyebrow" style="color:#fff">Join us</p><h2>{page.joinTitle}</h2></div><div><p>{page.joinText}</p><a class="button ghost" href="/positions">View open opportunities →</a></div></div></section>
</BaseLayout>
<style>.hero{min-height:76vh;position:relative;display:flex;align-items:flex-end;color:#fff;background:#171715}.hero-image{position:absolute;inset:0;background:url('/images/holder-exterior.jpg') center/cover}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,9,.95) 0%,rgba(10,10,9,.68) 52%,rgba(10,10,9,.18) 100%)}.hero-copy{position:relative;max-width:1400px;width:100%;margin:auto;padding:clamp(5rem,9vw,9rem) clamp(1.2rem,4vw,4rem)}.hero-copy h1{max-width:1100px}.hero-copy h1 em{font-weight:400;color:#f1a04c}.hero-copy>p:not(.eyebrow){font-size:clamp(1.05rem,1.5vw,1.25rem);line-height:1.55;max-width:720px;color:#e4e2de;margin:1.8rem 0 2.2rem}.section-head{display:flex;justify-content:space-between}.research-map .section-head{margin-bottom:clamp(2.5rem,5vw,4.5rem)}.research-map .card{padding:clamp(1.6rem,3vw,2.4rem);border-top-width:4px}.research-map .card h3{font-size:clamp(1.55rem,2vw,2rem);line-height:1.12;margin:1.25rem 0 .8rem}.research-map .card p{font-size:1rem;line-height:1.6}.research-map .crosscut{background:#f0edf6;color:var(--ink);border-top-color:#76579a}.research-map .crosscut p{color:#5f5867}.research-map .crosscut .number{color:#76579a}.news-dark a{display:grid;grid-template-columns:8rem 1fr auto;gap:1rem;color:#fff;text-decoration:none;padding:1.2rem 0;border-bottom:1px solid #3a3a37}.news-dark time{font-size:.72rem;color:#aaa;text-transform:uppercase}.news-dark b{color:var(--orange)}@media(max-width:700px){.hero{min-height:700px}.news-dark a{grid-template-columns:1fr auto}.news-dark time{grid-column:1}.news-dark span{grid-column:1}.news-dark b{grid-column:2;grid-row:1/3}}</style>
