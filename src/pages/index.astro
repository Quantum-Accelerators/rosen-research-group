---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';
import news from '../data/news.json';

const page = (await getEntry('pages', 'home'))!.data as any;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="home-title">
    <div class="container intro-grid">
      <div class="intro-copy">
        <p class="eyebrow">{page.heroEyebrow}</p>
        <h1 id="home-title">{page.heroTitle}{page.heroAccent && <> {page.heroAccent}</>}</h1>
        <p class="intro-text">{page.heroIntro}</p>
        <a class="text-link" href="/research">Our research <span aria-hidden="true">→</span></a>
      </div>
      <figure class="campus-photo">
        <img src={`${baseUrl}images/holder-exterior.jpg`} width="1440" height="540" alt="Stone archway and courtyard on Princeton's campus" fetchpriority="high" />
        <figcaption>Princeton University</figcaption>
      </figure>
    </div>
  </section>
  <section class="section research-summary" aria-labelledby="research-heading">
    <div class="container research-layout">
      <div class="research-heading">
        <h2 id="research-heading">{page.areasTitle}</h2>
        <a class="text-link" href="/research">Research overview <span aria-hidden="true">→</span></a>
      </div>
      <div class="research-list">
        {page.areas.map((area:any) => <article><h3>{area.title}</h3><p>{area.text}</p></article>)}
      </div>
    </div>
  </section>
  <section class="section group-updates" aria-labelledby="news-heading">
    <div class="container updates-grid">
      <figure class="group-photo">
        <a href="/members"><img src={`${baseUrl}images/group-bowling-spring-2026.jpg`} width="1440" height="1080" alt="Rosen Research Group members together at a bowling alley" loading="lazy" /></a>
        <figcaption>Group bowling, spring 2026 <a class="text-link" href="/members">Meet the group <span aria-hidden="true">→</span></a></figcaption>
      </figure>
      <div>
        <div class="news-heading"><h2 id="news-heading">{page.latestTitle}</h2><a class="text-link" href="/news">All news <span aria-hidden="true">→</span></a></div>
        <div class="home-news">
          {news.slice(0,4).map(item => <a href={item.path}><time>{item.date}</time><span>{item.title}</span></a>)}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-intro { background: var(--paper); padding: 3.75rem 0 3rem; }
  .intro-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 3.5rem; align-items: center; }
  .intro-copy { padding-bottom: 1rem; }
  .eyebrow { font-weight: 400; color: var(--muted); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(2.2rem, 3.6vw, 3.25rem); font-weight: 600; line-height: 1.12; letter-spacing: -.04em; margin: 0; }
  .intro-text { font-size: 1.12rem; line-height: 1.65; margin: 1.5rem 0; max-width: 34rem; }
  .text-link { font-size: .9rem; font-weight: 600; }
  figure { margin: 0; }
  .campus-photo img { display: block; width: 100%; height: 365px; object-fit: cover; object-position: center; }
  figcaption { color: var(--muted); font-size: .78rem; margin-top: .6rem; }
  .research-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; }
  .research-heading h2 { font-size: 1.65rem; margin-bottom: 1rem; }
  .research-list article { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .research-list article:first-child { padding-top: 0; border: 0; }
  .research-list h3 { font-size: 1.15rem; line-height: 1.4; margin: 0; }
  .research-list p { font-size: .95rem; line-height: 1.6; color: var(--muted); margin: 0; }
  .group-updates { border-top: 1px solid var(--line); padding-top: 3.5rem; }
  .updates-grid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 4rem; }
  .group-photo img { display: block; width: 100%; height: auto; }
  .group-photo figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; }
  .group-photo figcaption .text-link { font-size: .78rem; }
  .news-heading { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: .5rem 1rem; margin-bottom: 1rem; }
  .news-heading h2 { font-size: 1.65rem; margin: 0; }
  .home-news a { display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; text-decoration: none; padding: 1rem 0; border-top: 1px solid var(--line); }
  .home-news a:hover span { text-decoration: underline; }
  .home-news time { color: var(--muted); font-size: .75rem; padding-top: .2rem; }
  .home-news span { font-size: .95rem; font-weight: 600; line-height: 1.5; }
  @media (max-width: 900px) {
    .intro-grid { gap: 2rem; }
    .research-layout { grid-template-columns: 1fr; gap: 2rem; }
    .research-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .research-heading h2 { margin: 0; }
    .updates-grid { gap: 2rem; }
  }
  @media (max-width: 700px) {
    .home-intro { padding: 2.5rem 0 2rem; }
    .intro-grid, .updates-grid { grid-template-columns: 1fr; }
    .intro-copy { padding: 0; }
    h1 { font-size: clamp(2rem, 7.5vw, 3rem); }
    .campus-photo img { height: 270px; }
    .research-list article { grid-template-columns: 1fr; gap: .65rem; }
    .group-updates { padding-top: 2.5rem; }
    .updates-grid { gap: 2.5rem; }
  }
</style>
