---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const news=await getCollection('news');return news.map(item=>({params:{slug:item.id},props:{item}}))}
const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title}><PageHero eyebrow={item.data.date || item.id.split('/')[0]} title={item.data.title}/><section class="section white"><article class="container prose news-article"><Content /><p><a class="text-link" href="/news">← Back to all news</a></p></article></section></BaseLayout><style>.news-article{font-family:var(--serif);font-size:clamp(1.25rem,2.1vw,1.65rem);line-height:1.55}.news-article>p:last-child{font-family:var(--sans);font-size:1rem;margin-top:3rem}</style>
