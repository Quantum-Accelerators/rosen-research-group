---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getCollection } from 'astro:content';
const people = (await getCollection('members')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Members"><PageHero title="Members"/><section class="section white"><div class="container portrait-grid">{people.map(person=><article class="person"><a class="portrait-link" href={`/people/${person.id}`}><img src={`/images/${person.data.image}`} alt={person.data.name}/></a><h2><a href={`/people/${person.id}`}>{person.data.name}</a></h2><p>{person.data.role}</p></article>)}</div></section></BaseLayout><style>.portrait-link{display:block;overflow:hidden}.portrait-link img{transition:transform .35s ease}.portrait-link:hover img{transform:scale(1.025)}.person h2 a{text-decoration:none}.person h2 a:hover{color:var(--orange)}</style>
