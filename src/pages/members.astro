---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import people from '../data/members.json';
---
<BaseLayout title="Members"><PageHero title="Members"/><section class="section white"><div class="container portrait-grid">{people.map(person=><article class="person"><a class="portrait-link" href={`/people/${person.slug}`}><img src={`/images/${person.image}`} alt={person.name}/></a><h2><a href={`/people/${person.slug}`}>{person.name}</a></h2><p>{person.role}</p></article>)}</div></section><section class="section group-photos"><div class="container"><p class="eyebrow">Group life</p><h2>Group photos</h2><div class="photo-grid"><figure><img src="/images/group-bowling-spring-2026.jpg" alt="Rosen Research Group members at a bowling alley"/><figcaption>Group Bowling Spring 2026</figcaption></figure><figure><img src="/images/group-selfie-january-2026.jpg" alt="Rosen Research Group selfie"/><figcaption>Group selfie (Jan. 2026)</figcaption></figure><figure><img src="/images/group-escape-room-summer-2025.jpeg" alt="Rosen Research Group members celebrating an escape room record"/><figcaption>The group gets the Escape Room record (Summer 2025)</figcaption></figure><figure><img src="/images/first-group-photo-january-2025.jpg" alt="The first Rosen Research Group photo"/><figcaption>First group photo (Jan. 2025)</figcaption></figure></div></div></section></BaseLayout><style>.portrait-link{display:block;overflow:hidden}.portrait-link img{transition:transform .35s ease}.portrait-link:hover img{transform:scale(1.025)}.person h2 a{text-decoration:none}.person h2 a:hover{color:var(--orange)}.group-photos h2{margin-bottom:2rem}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem 1.5rem;align-items:start}.photo-grid figure{margin:0}.photo-grid img{display:block;width:100%;height:auto;border-radius:8px}.photo-grid figcaption{margin-top:.65rem;color:var(--muted);font-size:.9rem}@media(max-width:700px){.photo-grid{grid-template-columns:1fr}}</style>
