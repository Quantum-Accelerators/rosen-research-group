---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import people from '../data/members.json';
---
<BaseLayout title="Members"><PageHero title="Members"/><section class="section white"><div class="container portrait-grid">{people.map(person=><article class="person"><a class="portrait-link" href={`/people/${person.slug}`}><img src={`/images/${person.image}`} alt={person.name}/></a><h2><a href={`/people/${person.slug}`}>{person.name}</a></h2><p>{person.role}</p>{person.slug === 'jaehong-russell-kwon' && <p class="person-note">Co-advised by David Graves</p>}</article>)}</div></section></BaseLayout><style>.portrait-link{display:block;overflow:hidden}.portrait-link img{transition:transform .35s ease}.portrait-link:hover img{transform:scale(1.025)}.person h2 a{text-decoration:none}.person h2 a:hover{color:var(--orange)}.person .person-note{margin-top:.25rem;color:var(--ink)}</style>
