---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import people from '../../data/members.json';
export function getStaticPaths(){return people.map(person=>({params:{slug:person.slug},props:{person}}))}
const { person } = Astro.props;
---
<BaseLayout title={person.name}><PageHero eyebrow="Group member" title={person.name}/><section class="section white"><div class="container member-profile"><img src={`/images/${person.image}`} alt={person.name}/><article><p class="role">{person.role}</p>{person.affiliation && <p class="affiliation">{person.affiliation}</p>}{person.email && <p><a class="button" href={`mailto:${person.email}`}>{person.email}</a></p>}{person.about.length > 0 && <div class="details"><h2>About</h2>{person.about.map((line:string)=><p>{line}</p>)}</div>}<p class="back"><a class="text-link" href="/members">← Back to all members</a></p></article></div></section></BaseLayout><style>.member-profile{display:grid;grid-template-columns:minmax(260px,390px) 1fr;gap:clamp(3rem,8vw,8rem);align-items:start}.member-profile>img{width:100%;aspect-ratio:3/4;object-fit:cover}.role{font:500 clamp(2rem,4vw,3.5rem)/1.1 var(--serif);margin:0 0 .6rem}.affiliation{font-size:1.05rem;color:var(--muted);margin:0 0 2rem}.details{border-top:1px solid var(--line);margin-top:3rem;padding-top:2rem}.details h2{font-size:2rem}.details p{font-size:1.05rem}.back{margin-top:3rem}@media(max-width:700px){.member-profile{grid-template-columns:1fr}}</style>
