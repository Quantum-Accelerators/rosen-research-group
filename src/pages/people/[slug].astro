---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const people=await getCollection('members');return people.map(person=>({params:{slug:person.id},props:{person}}))}
const { person } = Astro.props;
const { Content } = await render(person);
---
<BaseLayout title={person.data.name}><PageHero eyebrow="Group member" title={person.data.name}/><section class="section white"><div class="container member-profile"><img src={`/images/${person.data.image}`} alt={person.data.name}/><article><p class="role">{person.data.role}</p>{person.data.affiliation && <p class="affiliation">{person.data.affiliation}</p>}{person.data.email && <p><a class="button" href={`mailto:${person.data.email}`}>{person.data.email}</a></p>}{person.body && <div class="details"><h2>About</h2><Content /></div>}<p class="back"><a class="text-link" href="/members">← Back to all members</a></p></article></div></section></BaseLayout><style>.member-profile{display:grid;grid-template-columns:minmax(260px,390px) 1fr;gap:clamp(3rem,8vw,8rem);align-items:start}.member-profile>img{width:100%;aspect-ratio:3/4;object-fit:cover}.role{font:500 clamp(2rem,4vw,3.5rem)/1.1 var(--serif);margin:0 0 .6rem}.affiliation{font-size:1.05rem;color:var(--muted);margin:0 0 2rem}.details{border-top:1px solid var(--line);margin-top:3rem;padding-top:2rem}.details h2{font-size:2rem}.details :global(p){font-size:1.05rem}.back{margin-top:3rem}@media(max-width:700px){.member-profile{grid-template-columns:1fr}}</style>
