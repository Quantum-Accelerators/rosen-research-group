---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { getEntry, render } from 'astro:content';
const entry = (await getEntry('pages', 'andrew-s-rosen'))!;
const page = entry.data as any;
const { Content } = await render(entry);
---
<BaseLayout title={page.name}><PageHero eyebrow={page.eyebrow} title={page.name} intro={page.intro} />
<section class="section white"><div class="container profile"><aside><a class="portrait-home" href="https://rosen.cbe.princeton.edu/people/andrew-s-rosen"><img src={page.image} alt={page.name}/></a><a class="button cv-button" href={page.cvUrl}>Curriculum Vitae ↗</a><dl><dt>Office</dt><dd>{page.office}</dd><dt>Phone</dt><dd><a href={`tel:${page.phone}`}>{page.phone}</a></dd><dt>Email</dt><dd><a href={`mailto:${page.email}`}>{page.email}</a></dd><dt>Assistant</dt><dd><a href={page.assistant.url}>{page.assistant.name} ↗</a></dd><dt>Affiliations</dt><dd><ul class="affiliations">{page.affiliations.map((affiliation:string)=><li>{affiliation}</li>)}</ul></dd><dt>Online</dt><dd class="online-links">{page.links.map((link:any,index:number)=><>{index>0 && ' · '}<a href={link.url}>{link.label} ↗</a></>)}</dd></dl></aside><article class="prose"><p class="eyebrow">About</p><Content/></article></div></section></BaseLayout>
<style>.profile{display:grid;grid-template-columns:minmax(260px,360px) 1fr;gap:clamp(3rem,8vw,8rem)}aside img{width:100%;display:block}.cv-button{display:flex;justify-content:center;margin-top:1rem}dl{border-top:1px solid var(--line);margin-top:1.5rem}dt{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-top:1rem}dd{margin:0}.affiliations{list-style:none;margin:.25rem 0 0;padding:0}.affiliations li{padding:.35rem 0;border-bottom:1px solid var(--line);font-size:.9rem;line-height:1.4}.affiliations li:last-child{border-bottom:0}.prose h2{font-size:clamp(2.2rem,4vw,4rem)}@media(max-width:750px){.profile{grid-template-columns:1fr}}</style>

