---
import BaseLayout from '../../layouts/BaseLayout.astro'; import PageHero from '../../components/PageHero.astro'; import { getEntry, render } from 'astro:content';
const entry = (await getEntry('pages', 'andrew-s-rosen'))!;
const page = entry.data as any;
const { Content } = await render(entry);
---
<BaseLayout title={page.name}><PageHero eyebrow={page.eyebrow} title={page.name} intro={page.intro} />
<section class="section white"><div class="container profile"><aside><img src={page.image} alt={page.name}/><dl><dt>Office</dt><dd>{page.office}</dd><dt>Phone</dt><dd><a href={`tel:${page.phone}`}>{page.phone}</a></dd><dt>Email</dt><dd><a href={`mailto:${page.email}`}>{page.email}</a></dd><dt>Online</dt><dd>{page.links.map((link:any,index:number)=><>{index>0 && ' · '}<a href={link.url}>{link.label} ↗</a></>)}</dd></dl></aside><article class="prose"><p class="eyebrow">About</p><Content/><a class="button" href={page.cvUrl}>Curriculum Vitae ↗</a></article></div></section></BaseLayout>
<style>.profile{display:grid;grid-template-columns:minmax(260px,360px) 1fr;gap:clamp(3rem,8vw,8rem)}aside img{width:100%;display:block}dl{border-top:1px solid var(--line);margin-top:1.5rem}dt{font-size:.68rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);margin-top:1rem}dd{margin:0}.prose h2{font-size:clamp(2.2rem,4vw,4rem)}@media(max-width:750px){.profile{grid-template-columns:1fr}}</style>
