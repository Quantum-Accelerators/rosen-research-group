---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Content editor">
  <div class="cms-shell">
    <section class="cms-card" aria-labelledby="cms-title">
      <p class="cms-eyebrow">Rosen Research Group</p>
      <h1 id="cms-title">Content editor</h1>
      <p class="cms-intro">
        Update pages, people, news, publications, opportunities, and media without editing code.
        Changes are saved to GitHub and published by the existing Astro deployment workflow.
      </p>
      <a class="cms-button" href="https://app.pagescms.org/" target="_blank" rel="noreferrer">
        Open the CMS <span aria-hidden="true">↗</span>
      </a>
      <ol class="cms-steps">
        <li>Sign in with GitHub.</li>
        <li>Select <strong>Quantum-Accelerators / rosen-research-group</strong>.</li>
        <li>Choose a section, edit, and save.</li>
      </ol>
      <p class="cms-note">The first visit may ask an organization owner to approve or install the Pages CMS GitHub App.</p>
    </section>
  </div>
</BaseLayout>

<style>
  .cms-shell {
    min-height: 72vh;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vw, 7rem) 1.25rem;
    background:
      radial-gradient(circle at 85% 10%, rgba(232, 126, 42, 0.18), transparent 30rem),
      #f5f2eb;
  }

  .cms-card {
    width: min(100%, 48rem);
    padding: clamp(2rem, 6vw, 4.5rem);
    background: #fff;
    border-top: 0.4rem solid #e87722;
    box-shadow: 0 1.5rem 4rem rgba(18, 31, 43, 0.12);
  }

  .cms-eyebrow {
    margin: 0 0 1rem;
    color: #a34d0d;
    font-size: 0.78rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 0.98; }
  .cms-intro { max-width: 39rem; margin: 1.5rem 0 2rem; font-size: 1.12rem; line-height: 1.7; }

  .cms-button {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
    color: #fff;
    background: #121f2b;
    font-weight: 700;
    text-decoration: none;
  }

  .cms-button:hover { background: #e87722; }
  .cms-steps { margin: 2.25rem 0 0; padding-left: 1.25rem; line-height: 1.9; }
  .cms-note { margin: 1.5rem 0 0; padding-top: 1.25rem; border-top: 1px solid #d9d4ca; color: #59636c; font-size: 0.92rem; }
</style>
