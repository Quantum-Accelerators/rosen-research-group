---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'teaching'))!.data as any;
---
<BaseLayout title={page.title}><PageHero title={page.title} intro={page.intro}/><section class="section white"><div class="container">{page.courses.map((course:any)=><article class="course grid-2"><div><p class="eyebrow">{course.code} · {course.semesters}</p><h2>{course.title}</h2></div><div class="prose">{course.paragraphs.map((text:string)=><p>{text}</p>)}<a class="text-link" href={course.url}>Course details ↗</a></div></article>)}</div></section><section class="section dark"><div class="container grid-2"><div><p class="eyebrow">Beyond the classroom</p><h2>{page.beyondTitle}</h2></div><div class="prose"><p>{page.beyondText}</p><p><a class="button ghost" href={page.youtubeUrl}>YouTube ↗</a> <a class="button ghost" href={page.reviewUrl}>Rosen Review ↗</a></p></div></div></section></BaseLayout><style>.course{padding:3rem 0;border-bottom:1px solid var(--line)}.course:first-child{padding-top:0}</style>
