---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'research'))!.data as any;
---
<BaseLayout title={page.title}><PageHero title={page.title} />
<section class="section white approach"><div class="container"><div class="approach-intro"><p class="approach-lede">{page.approach}</p></div><div class="question-grid">{page.questions.map((question:string,index:number)=><article class="research-question"><span>Question {index+1}</span><h2>{question}</h2></article>)}</div><div class="crosscutting"><p class="eyebrow">Shared foundation</p><p>{page.crosscutting}</p></div></div></section>
{page.areas.map((area:any)=><section class="section research-area"><div class="container grid-2">{area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}<div class="prose"><p class="eyebrow">{area.label}</p><h2>{area.title}</h2>{area.paragraphs.map((text:string)=><p>{text}</p>)}{area.buttonUrl && <a class="button" href={area.buttonUrl}>{area.buttonLabel}</a>}</div>{!area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}</div></section>)}</BaseLayout><style>
  .approach { padding-block: 3rem; }
  .approach-intro { max-width: 780px; margin-bottom: 2rem; }
  .approach-lede { font-size: 1.2rem; line-height: 1.6; margin: 0; }
  .question-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .research-question { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .research-question span { display: block; color: var(--muted); font-size: .8rem; margin-bottom: .75rem; }
  .research-question h2 { font-size: 1.45rem; line-height: 1.45; margin: 0; font-weight: 500; }
  .crosscutting { max-width: 850px; margin-top: 1rem; }
  .crosscutting .eyebrow { margin-bottom: .5rem; }
  .crosscutting p:last-child { margin: 0; }
  .research-area { border-top: 1px solid var(--line); }
  .research-area .grid-2 { align-items: center; }
  .image-frame img { height: auto; object-fit: contain; }
  @media (max-width: 700px) { .question-grid { grid-template-columns: 1fr; gap: 1rem; } }
</style>
