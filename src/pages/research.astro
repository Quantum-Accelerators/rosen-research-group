---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'research'))!.data as any;
---
<BaseLayout title={page.title}><PageHero title={page.title} intro={page.intro} showIntro={true} />
<section class="section white approach"><div class="container"><div class="approach-intro"><p class="approach-lede" style="grid-column:1/-1;text-align:center">{page.approach}</p></div><div class="question-grid">{page.questions.map((question:string,index:number)=><article class="research-question"><span>Research question {String(index+1).padStart(2,'0')}</span><h2>{question}</h2></article>)}</div><div class="crosscutting"><p class="eyebrow">Shared foundation</p><p>{page.crosscutting}</p></div></div></section>
{page.areas.map((area:any)=><section class:list={{section:true,dark:area.theme==='dark',white:area.theme==='white'}}><div class="container grid-2">{area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}<div class="prose"><p class="eyebrow">{area.label}</p><h2>{area.title}</h2>{area.paragraphs.map((text:string)=><p>{text}</p>)}{area.buttonUrl && <a class="button" href={area.buttonUrl}>{area.buttonLabel}</a>}</div>{!area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}</div></section>)}</BaseLayout><style>.approach{padding-top:clamp(3.5rem,6vw,5.5rem);padding-bottom:clamp(3.5rem,6vw,5.5rem)}.approach-intro{display:grid;grid-template-columns:10rem minmax(0,1fr);column-gap:clamp(2rem,5vw,5rem);align-items:start;max-width:1040px;padding-bottom:clamp(2.25rem,4vw,3.5rem)}.approach-intro .eyebrow{margin:.4rem 0 0}.approach-intro p{margin:0}.approach-lede{font:400 clamp(1.65rem,2.6vw,2.5rem)/1.22 var(--serif);letter-spacing:-.02em}.question-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;padding:0 0 clamp(2rem,4vw,3rem)}.research-question{position:relative;padding:clamp(1.5rem,2.5vw,2.25rem);border:1px solid var(--line);border-radius:10px;background:#faf9f6}.research-question span{display:block;color:var(--orange);font-size:.72rem;font-weight:700;letter-spacing:.12em;margin-bottom:1.25rem}.research-question h2{font-size:clamp(1.5rem,2.2vw,2.2rem);line-height:1.16;margin:0}.crosscutting{display:grid;grid-template-columns:10rem 1fr;gap:clamp(2rem,5vw,5rem);align-items:start;padding:clamp(1.5rem,2.5vw,2.1rem);background:#f1eee7;border-left:3px solid var(--orange);border-radius:0 8px 8px 0}.crosscutting .eyebrow,.crosscutting p{margin:0}.crosscutting p:last-child{max-width:850px;font-size:1.05rem}.image-frame{border-radius:10px;box-shadow:0 14px 36px rgba(24,24,20,.08)}.prose .button{color:#fff}@media(max-width:850px){.approach-intro{grid-template-columns:1fr}.approach-intro .eyebrow{margin:0 0 1rem}.question-grid{grid-template-columns:1fr}.crosscutting{grid-template-columns:1fr;gap:.75rem}}</style>
