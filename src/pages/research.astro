---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import { getEntry } from 'astro:content';
const page = (await getEntry('pages', 'research'))!.data as any;
---
<BaseLayout title={page.title}><PageHero title={page.title} intro={page.intro} showIntro={true} />
<section class="section white approach"><div class="container"><div class="approach-intro"><p class="eyebrow">Our approach</p><p class="approach-lede">{page.approach}</p></div><div class="question-grid">{page.questions.map((question:string,index:number)=><article class="research-question"><span>{String(index+1).padStart(2,'0')}</span><h2>{question}</h2></article>)}</div><div class="crosscutting"><p class="eyebrow">Crosscutting effort</p><p>{page.crosscutting}</p></div></div></section>
{page.areas.map((area:any)=><section class:list={{section:true,dark:area.theme==='dark',white:area.theme==='white'}}><div class="container grid-2">{area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}<div class="prose"><p class="eyebrow">{area.label}</p><h2>{area.title}</h2>{area.paragraphs.map((text:string)=><p>{text}</p>)}{area.buttonUrl && <a class="button" href={area.buttonUrl}>{area.buttonLabel}</a>}</div>{!area.imageFirst && <div class="image-frame"><img src={area.image} alt={area.imageAlt}/></div>}</div></section>)}</BaseLayout><style>.approach{padding-top:clamp(3.5rem,6vw,6rem);padding-bottom:clamp(3.5rem,6vw,5.5rem)}.approach-intro{display:grid;grid-template-columns:9rem minmax(0,1fr);column-gap:clamp(2rem,5vw,5rem);align-items:start;max-width:1040px;padding-bottom:clamp(2.5rem,5vw,4rem)}.approach-intro .eyebrow{margin:.4rem 0 0}.approach-intro p{margin:0}.approach-lede{font:400 clamp(1.75rem,3vw,2.8rem)/1.2 var(--serif);letter-spacing:-.025em}.question-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2.5rem,6vw,6rem);padding:clamp(2.25rem,4vw,3.5rem) 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.research-question{position:relative;padding-left:clamp(3.5rem,5vw,4.75rem)}.research-question span{position:absolute;left:0;top:.15rem;display:grid;place-items:center;width:2.65rem;height:2.65rem;border-radius:50%;background:var(--orange);color:#fff;font-size:.72rem;font-weight:700;letter-spacing:.1em}.research-question h2{font-size:clamp(1.65rem,2.5vw,2.5rem);line-height:1.14;margin:0}.crosscutting{display:grid;grid-template-columns:9rem 1fr;gap:clamp(2rem,5vw,5rem);align-items:start;margin-top:clamp(2rem,3vw,3rem);padding:clamp(1.5rem,2.5vw,2.25rem) clamp(1.5rem,3vw,3rem);background:#f4eee5;border-left:4px solid var(--orange)}.crosscutting .eyebrow,.crosscutting p{margin:0}.crosscutting p:last-child{max-width:850px;font-size:1.08rem}.image-frame{border-radius:18px;box-shadow:0 16px 40px rgba(24,24,20,.08)}.prose .button{color:#fff}@media(max-width:850px){.approach-intro{grid-template-columns:1fr}.approach-intro .eyebrow{margin:0 0 1rem}.question-grid{grid-template-columns:1fr;gap:2rem}.crosscutting{grid-template-columns:1fr;gap:.75rem}}@media(max-width:700px){.research-question{padding-left:3.5rem}}</style>
